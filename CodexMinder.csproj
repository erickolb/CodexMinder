<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.2.3</Version>
    <Authors>Eric Kolb</Authors>
    <Description>Independent Windows taskbar companion for remaining Codex usage allowances.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup><Compile Remove="tests/**/*.cs" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/Blossom_Light.svg" /></ItemGroup>
  <ItemGroup><Using Include="System.IO" /></ItemGroup>
</Project>
